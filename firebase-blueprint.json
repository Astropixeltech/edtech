{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile in the platform",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Auth UID of the user"
        },
        "fullName": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "enum": ["admin", "teacher", "student"]
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 500
        },
        "phoneNumber": {
          "type": "string",
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "email", "role"]
    },
    "Course": {
      "title": "Course",
      "description": "EdTech course catalog item",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "titleEn": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 3000
        },
        "descriptionEn": {
          "type": "string",
          "maxLength": 3000
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "thumbnailUrl": {
          "type": "string",
          "maxLength": 500
        },
        "price": {
          "type": "number"
        },
        "isPublished": {
          "type": "boolean"
        },
        "trainerName": {
          "type": "string",
          "maxLength": 100
        },
        "totalClasses": {
          "type": "number"
        },
        "duration": {
          "type": "string",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "price", "isPublished"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Course enrollment for a student",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "courseId": {
          "type": "string"
        },
        "studentEmail": {
          "type": "string",
          "format": "email"
        },
        "status": {
          "type": "string",
          "enum": ["active", "completed", "cancelled"]
        },
        "progress": {
          "type": "number"
        },
        "enrolledAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "courseId", "status"]
    },
    "EnrollmentRequest": {
      "title": "EnrollmentRequest",
      "description": "Pending payment/enrollment request",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "courseId": {
          "type": "string"
        },
        "studentName": {
          "type": "string",
          "maxLength": 100
        },
        "studentEmail": {
          "type": "string",
          "format": "email"
        },
        "phoneNumber": {
          "type": "string",
          "maxLength": 20
        },
        "paymentMethod": {
          "type": "string",
          "maxLength": 50
        },
        "transactionId": {
          "type": "string",
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "courseId", "studentEmail", "status"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Notice board post or announcement",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "content": {
          "type": "string",
          "maxLength": 4000
        },
        "courseId": {
          "type": "string"
        },
        "authorId": {
          "type": "string"
        },
        "authorName": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "content", "authorId"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document keyed by auth UID"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Published and draft course offerings"
    },
    "/enrollments/{enrollmentId}": {
      "schema": { "$ref": "#/entities/Enrollment" },
      "description": "Student enrollment records"
    },
    "/enrollment_requests/{requestId}": {
      "schema": { "$ref": "#/entities/EnrollmentRequest" },
      "description": "Student enrollment verification requests"
    },
    "/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/Notice" },
      "description": "Announcements and notices"
    }
  }
}
